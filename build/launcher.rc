#include <winver.h>

1 ICON "../assets/app_icon.ico"
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,5,0,0
 PRODUCTVERSION 2,5,0,0
 FILEFLAGSMASK 0x3fL
